graph TB
    %% External Systems
    subgraph "External Services"
        VNPay[VNPay Payment Gateway]
        Gmail[Gmail SMTP]
        Cloudinary[Cloudinary CDN]
        Redis[Redis Cache]
        PostgreSQL[(PostgreSQL Database)]
    end

    %% Frontend Layer
    subgraph "Frontend Layer"
        WebApp[Web Application]
        MobileApp[Mobile Application]
    end

    %% API Gateway / Load Balancer
    subgraph "API Layer"
        APIGateway[API Gateway<br/>/api/v1]
    end

    %% Main Application
    subgraph "E-Commerce Backend Application"
        subgraph "Security Layer"
            JWTFilter[JWT Authentication Filter]
            SecurityConfig[Web Security Configuration]
            LoginAttemptService[Login Attempt Service]
        end

        subgraph "Controller Layer"
            AccountController[Account Controller<br/>/auth]
            UserInfoController[User Information Controller]
            ProductController[Product Controller<br/>/products]
            CategoryController[Category Controller<br/>/categories]
            OrderController[Order Controller<br/>/orders]
            CartController[Cart Controller<br/>/cart]
            PaymentController[Payment Controller<br/>/payments]
            InvoiceController[Invoice Controller]
            VoucherController[Voucher Controller]
            OTPController[OTP Controller]
        end

        subgraph "Service Layer"
            AccountService[Account Service]
            UserInfoService[User Information Service]
            ProductService[Product Service]
            CategoryService[Category Service]
            OrderService[Order Service]
            CartService[Cart Service]
            PaymentService[Payment Service]
            EmailService[Email Service]
            InvoiceService[Invoice Service]
            VoucherService[Voucher Service]
            OTPService[OTP Service]
        end

        subgraph "Repository Layer"
            AccountRepo[Account Repository]
            UserInfoRepo[User Information Repository]
            ProductRepo[Product Repository]
            CategoryRepo[Category Repository]
            OrderRepo[Order Repository]
            CartRepo[Cart Repository]
            PaymentRepo[Payment Repository]
            InvoiceRepo[Invoice Repository]
            VoucherRepo[Voucher Repository]
            TokenRepo[Token Repository]
        end

        subgraph "Entity Layer"
            Account[Account Entity]
            UserInfo[User Information Entity]
            Product[Product Entity]
            Category[Category Entity]
            Order[Order Entity]
            Cart[Cart Entity]
            Payment[Payment Entity]
            Invoice[Invoice Entity]
            Voucher[Voucher Entity]
            Token[Token Entity]
        end

        subgraph "Utility Services"
            JWTUtil[JWT Utility]
            VNPayUtil[VNPay Utility]
            CloudinaryService[Cloudinary Service]
            IdGenerator[ID Generator]
            OtpUtil[OTP Utility]
            RedisKeyUtil[Redis Key Utility]
        end

        subgraph "Event Handling"
            RegistrationEvent[Registration Complete Event]
            ForgotPasswordEvent[Forgot Password Event]
            EventListeners[Event Listeners]
        end

        subgraph "Exception Handling"
            CustomException[Custom Exception Handler]
            ErrorResponse[Error Response]
        end
    end

    %% Data Flow Connections
    WebApp --> APIGateway
    MobileApp --> APIGateway
    APIGateway --> JWTFilter
    JWTFilter --> SecurityConfig
    SecurityConfig --> AccountController
    SecurityConfig --> ProductController
    SecurityConfig --> OrderController
    SecurityConfig --> PaymentController

    %% Controller to Service connections
    AccountController --> AccountService
    UserInfoController --> UserInfoService
    ProductController --> ProductService
    CategoryController --> CategoryService
    OrderController --> OrderService
    CartController --> CartService
    PaymentController --> PaymentService
    InvoiceController --> InvoiceService
    VoucherController --> VoucherService
    OTPController --> OTPService

    %% Service to Repository connections
    AccountService --> AccountRepo
    UserInfoService --> UserInfoRepo
    ProductService --> ProductRepo
    CategoryService --> CategoryRepo
    OrderService --> OrderRepo
    CartService --> CartRepo
    PaymentService --> PaymentRepo
    InvoiceService --> InvoiceRepo
    VoucherService --> VoucherRepo
    OTPService --> TokenRepo

    %% Repository to Entity connections
    AccountRepo --> Account
    UserInfoRepo --> UserInfo
    ProductRepo --> Product
    CategoryRepo --> Category
    OrderRepo --> Order
    CartRepo --> Cart
    PaymentRepo --> Payment
    InvoiceRepo --> Invoice
    VoucherRepo --> Voucher
    TokenRepo --> Token

    %% Entity relationships
    Account --> UserInfo
    Account --> Order
    Account --> Cart
    Order --> Payment
    Order --> Invoice
    Product --> Category

    %% External service connections
    PaymentService --> VNPay
    EmailService --> Gmail
    ProductService --> CloudinaryService
    CloudinaryService --> Cloudinary
    AccountService --> Redis
    OTPService --> Redis
    LoginAttemptService --> Redis

    %% Database connections
    AccountRepo --> PostgreSQL
    UserInfoRepo --> PostgreSQL
    ProductRepo --> PostgreSQL
    CategoryRepo --> PostgreSQL
    OrderRepo --> PostgreSQL
    CartRepo --> PostgreSQL
    PaymentRepo --> PostgreSQL
    InvoiceRepo --> PostgreSQL
    VoucherRepo --> PostgreSQL
    TokenRepo --> PostgreSQL

    %% Utility connections
    AccountService --> JWTUtil
    PaymentService --> VNPayUtil
    ProductService --> IdGenerator
    OTPService --> OtpUtil
    AccountService --> RedisKeyUtil

    %% Event connections
    AccountService --> RegistrationEvent
    AccountService --> ForgotPasswordEvent
    RegistrationEvent --> EventListeners
    ForgotPasswordEvent --> EventListeners
    EventListeners --> EmailService

    %% Exception handling
    AccountController --> CustomException
    ProductController --> CustomException
    OrderController --> CustomException
    PaymentController --> CustomException
    CustomException --> ErrorResponse

    %% Styling
    classDef external fill:#ffcccc,stroke:#ff0000,stroke-width:2px
    classDef frontend fill:#ccffcc,stroke:#00ff00,stroke-width:2px
    classDef controller fill:#ccccff,stroke:#0000ff,stroke-width:2px
    classDef service fill:#ffffcc,stroke:#ffff00,stroke-width:2px
    classDef repository fill:#ffccff,stroke:#ff00ff,stroke-width:2px
    classDef entity fill:#ccffff,stroke:#00ffff,stroke-width:2px
    classDef utility fill:#ffeecc,stroke:#ff8800,stroke-width:2px

    class VNPay,Gmail,Cloudinary,Redis,PostgreSQL external
    class WebApp,MobileApp frontend
    class AccountController,UserInfoController,ProductController,CategoryController,OrderController,CartController,PaymentController,InvoiceController,VoucherController,OTPController controller
    class AccountService,UserInfoService,ProductService,CategoryService,OrderService,CartService,PaymentService,EmailService,InvoiceService,VoucherService,OTPService service
    class AccountRepo,UserInfoRepo,ProductRepo,CategoryRepo,OrderRepo,CartRepo,PaymentRepo,InvoiceRepo,VoucherRepo,TokenRepo repository
    class Account,UserInfo,Product,Category,Order,Cart,Payment,Invoice,Voucher,Token entity
    class JWTUtil,VNPayUtil,CloudinaryService,IdGenerator,OtpUtil,RedisKeyUtil utility

